# =============================================================================
# .env.example for SHAHEEN-YS Backend
# Copy this file to .env and fill in required values.
# =============================================================================

# ---------- Server ----------
PORT=3000
NODE_ENV=production

# ---------- Database (Postgres) ----------
# Example: postgresql://username:password@host:5432/database
DATABASE_URL=

# ---------- JWT / Auth ----------
# Required for authentication to work
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------- AI Provider Keys (only set ones you use) ----------
# Optional: set whichever providers you enable
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TAVILY_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
ELEVENLABS_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ---------- Other / Optional ----------
# e.g., external service endpoints, feature flags
#EXTERNAL_SERVICE_URL=
#FEATURE_FLAG_X=true

# =============================================================================
# Notes:
# - REQUIRED: DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET for full functionality.
# - Railway: set these variables in the Railway project settings (Environment Variables).
# =============================================================================
